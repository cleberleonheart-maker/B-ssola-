<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Rastreio ao vivo com a tela apagada: sem isso o LocationManager para
         de entregar fix quando o app vai para background, e quem assiste ao
         link vê "SEM SINAL" durante uma emergência. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Reconhecimento de voz da assistente Virgin -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Câmera para o modo de visão AR -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Vibração (modo detector de metal) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Instalação das atualizações baixadas pelo próprio app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Notificações (geofence/waypoints) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- O modo de assalto (ideia #107) manda o SOS por SMS sem abrir a app de
         SMS. A permissao e pedida nas defincoes, antes de ser preciso. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- O servico que conta e manda o aviso do modo de assalto (ideia #107).
         Vive em foreground durante a contagem para o Android nao adiar o
         aviso; e do tipo "dataSync" porque e um envio de dados. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Sensores usados pela bússola -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />

    <!-- Android 11+ (API 30) esconde servicos de terceiros por omissao. Sem esta
         declaracao o SpeechRecognizer.isRecognitionAvailable() devolve false, a
         Kefera conclui que nao ha voz e nunca abre o microfone pela palavra de
         ativacao, e so o comando escrito funciona. Declarar o servico de
         reconhecimento devolve-lhe visibilidade. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Atalho do widget para o SOS (ideia #105): o botão "Partilhar" do
             widget abre a app já no ecrã de emergência, que é onde a sessão e
             o link são criados. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="bussola" android:host="sos" />
        </intent-filter>
        <!-- Atalhos dos tiles das Definições Rápidas (ideia #14): cada tile
             abre a app já no seu modo, com `bussola://mode/<modo>`. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="bussola" android:host="mode" />
        </intent-filter>
      </activity>

      <!-- Tiles das Definições Rápidas (ideia #14): um por modo, e cada um
           abre a app nesse modo. O Android só mostra um tile por serviço, por
           isso há uma classe por modo (todas herdadas de ModeTileService). -->
      <service
        android:name=".TileCompass"
        android:label="@string/tile_compass"
        android:icon="@drawable/ic_tile_bussola"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
        android:exported="true">
        <intent-filter>
          <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent-filter>
      </service>
